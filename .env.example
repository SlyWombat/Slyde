# Slyde configuration — copy to `.env` and fill in. Nothing is hardcoded; every
# deployment value lives here. (Do NOT commit your real .env — it is gitignored.)

# --- Frame -------------------------------------------------------------------
# Which kind of frame to drive (see docs/frame-backends.md):
#   memento-lan   = the reverse-engineered Memento LAN protocol (default; also emulator/soft-frame)
#   sungale-cloud = Aluratek/Sungale Spectra-6 ePaper, by impersonating its cloud. The frame polls
#                   us over plain HTTP: point an AdGuard Home DNS rewrite of the vendor host
#                   (us.xiaowooya.eframe.sungale.com.cn) at Slyde. FRAME_HOST/FRAME_DISCOVERY don't
#                   apply (cloud frames register themselves by serial); FRAME_CANVAS is ignored —
#                   the panel's native 1200x1600 is fixed and images are delivered as its 4bpp BMP.
FRAME_BACKEND=memento-lan
# Served (cloud) backends to ALSO mount alongside the primary, so ONE hub drives both a connected
# frame and a polled one (comma-separated). e.g. keep FRAME_BACKEND=memento-lan and set this to
# sungale-cloud to manage the Memento frame and the eFrame from a single Slyde + shared registry.
FRAME_SERVED_BACKENDS=
# Leave FRAME_HOST empty to auto-discover the frame on the LAN (UDP broadcast).
# Set it to the frame's IP if discovery can't reach it (e.g. across subnets/VLANs).
FRAME_HOST=
# Extra frame hosts to always show in the picker (comma-separated) — e.g. an emulator the app
# can't reach by broadcast (Docker bridge networking blocks UDP discovery).
FRAME_HOSTS=
FRAME_DISCOVERY=true
# Fallback image size, used only if a frame doesn't report its own Width/Height. Images are
# normally prepared to the frame's reported resolution/orientation. (35" landscape = 3240x2160.)
FRAME_CANVAS=3240x2160
# How off-aspect photos fill the canvas: contain (solid bars) | cover (crop to fill) |
# blur (blurred sides) | smart (crop near-aspect, blur-fill portraits — like the original).
FRAME_FIT=smart
# Smart mode only: crop to fill when <= this fraction of the long edge is lost, else blur-fill.
FRAME_CROP_TOLERANCE=0.12

# --- Interlude: your own image between the photos (#70) -----------------------
# Slyde can show one recurring non-photo image between a frame's photos (a clock, a weather board,
# a dashboard). Slyde doesn't draw it — a SEPARATE PROCESS does, by writing a file. Change the file
# and the frame shows the new picture; DELETE it and the frame goes straight back to its ordinary
# slideshow. Full guide: docs/interlude.md. Memento/LAN frames only — e-paper frames refuse it.
# Where each frame's image lives: <INTERLUDE_DIR>/<frame-id>.img. Defaults to <CACHE_DIR>/interlude.
# Bind-mount this if the producer runs outside the Slyde container.
#INTERLUDE_DIR=/data/interlude
# How often the image is re-checked — also how quickly a REMOVED image returns the frame to normal.
#INTERLUDE_POLL_SECONDS=5
# What the frame's own slide timer is parked at while Slyde conducts the rotation. Leave unset:
# Slyde computes a finite value from the slide/dwell time, so the frame's own timer acts as a
# DEAD-MAN SWITCH — Slyde's transitions keep re-arming it so it never fires, but if Slyde dies the
# frame resumes its own slideshow on its own. (Verified on fw 6.02: DisplayImage re-arms the
# countdown, and arbitrary second values are honoured — the app's 15-rung picker is just its UI.)
# Set 2419200 ("never") for the old behaviour: the frame holds the last image until Slyde restarts.
#INTERLUDE_PARK_SECONDS=0
# Consecutive agreeing polls before engaging/standing down (stops a rewritten file from flapping).
#INTERLUDE_FLAP_THRESHOLD=2
# Timeout for fetching a url-sourced interlude image.
#INTERLUDE_FETCH_TIMEOUT=10

# --- SwitchBot AI Art Frame (#64) --------------------------------------------
# The 'switchbot' backend drives the SwitchBot AI Art Frame either:
#   - directly via SwitchBot's official OpenAPI (SWITCHBOT_DELIVERY_MODE=cloud_only), or
#   - via Home Assistant's ha-switchbot-art-frame integration (SWITCHBOT_DELIVERY_MODE=ha_service),
#     which handles BLE wake-up, 10-slot local FIFO deletion, and cloud album cleanup.
# Create a token/secret in the SwitchBot app: Profile > Preferences > tap "App Version" ~10x >
# Developer Options. Blank if unused.
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
SWITCHBOT_DEVICE_ID=
# Panel size in inches: 7.3 (480x800), 13.3 (1200x1600), or 31.5 (1440x2560)
SWITCHBOT_FRAME_SIZE=7.3
# Orientation: portrait | landscape
SWITCHBOT_ORIENTATION=portrait
# Max JPEG size in bytes before adaptive quality reduction (650 KB stays under the ~1 MiB base64 limit)
SWITCHBOT_MAX_IMAGE_BYTES=650000
# Slideshow over the frame's whole library (added, uploaded and kept-in-sync photos): off (deliver
# every photo) | slyde (Slyde sends ONE new photo per interval, every photo once before repeats — set the frame to a static image in
# the SwitchBot app) | frame (Slyde swaps all 10 photos per interval and the frame's own slideshow
# cycles them; with ha_service the photos are stored without being shown, which needs
# ha-switchbot-art-frame with show_image's "show" option)
SWITCHBOT_SLIDESHOW=off
# slyde: minutes between photo changes (also the album sync cycle); frame: minutes between batches
SWITCHBOT_SLIDESHOW_INTERVAL_MINUTES=60
# No slideshow changes in this local-time window, e.g. 22:00-07:00 (empty = none)
SWITCHBOT_QUIET_HOURS=
# Only change while this Home Assistant entity says someone is home (zone.home, person.x, group.x,
# binary_sensor.x; home/on or a count > 0). Empty = always. Interval, quiet hours and presence are
# defaults: each frame can override them in the UI (Settings -> Slideshow).
SWITCHBOT_PRESENCE_ENTITY=
# Delivery mode: cloud_only | ha_service
SWITCHBOT_DELIVERY_MODE=cloud_only
# Home Assistant bridge settings (used when SWITCHBOT_DELIVERY_MODE=ha_service; in a Home Assistant
# Add-on, HA_BASE_URL and HA_TOKEN default automatically to http://supervisor/core + SUPERVISOR_TOKEN).
# HA_ART_FRAME_ENTITY_ID is the integration's local_images sensor, e.g. sensor.art_frame_local_images
HA_BASE_URL=
HA_TOKEN=
HA_ART_FRAME_ENTITY_ID=

# --- Immich ------------------------------------------------------------------
# Base URL of your Immich instance and an API key (Immich: Account Settings > API Keys).
IMMICH_BASE_URL=http://immich:2283
IMMICH_API_KEY=
# Which Immich rendition to pull: a thumbnail size (preview|thumbnail) or "original".
IMMICH_ASSET_SIZE=preview
# How often (minutes) to re-mirror "kept in sync" albums to pick up new/removed items (0 = off).
SYNC_INTERVAL_MINUTES=15

# --- Firmware / app updates (soft-frame OTA) ---------------------------------
# GitHub owner/repo whose releases carry soft-frame update bundles (<track>.zip + .zip.md5).
FIRMWARE_REPO=
# Release-asset prefix / device track to update.
FIRMWARE_TRACK=memento-softframe
# Only needed if FIRMWARE_REPO is a private repo (a token with read access to its releases).
FIRMWARE_GITHUB_TOKEN=
# This manager's base URL as a *frame* can reach it (used in the update serve URL). If empty,
# it's derived from the incoming request — set it when frames reach the manager by a fixed IP.
MANAGER_BASE_URL=

# --- Service -----------------------------------------------------------------
# uid:gid the container runs as (compose `user:`; read by `docker compose`, not by the app).
# Defaults to 1000:1000. To run under a dedicated account, set these AND make /data writable by
# that uid — e.g. bind-mount a directory owned by it, or re-own an existing volume (docs/USAGE.md).
#SLYDE_UID=1000
#SLYDE_GID=1000
DATABASE_URL=sqlite:////data/memento.db
# Where prepared (edited) frame images are cached, ready to serve/push (one dir per frame).
CACHE_DIR=/data/cache
BIND_HOST=0.0.0.0
BIND_PORT=8080
# Directory of the built web UI to serve (set inside the container image).
STATIC_DIR=
LOG_LEVEL=INFO
